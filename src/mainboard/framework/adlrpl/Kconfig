	default "Laptop (12th Gen Intel Core)" if BOARD_FRAMEWORK_HX30

config MAINBOARD_FAMILY
	default "13in Laptop"

config CONSOLE_POST
	default y

config DIMM_MAX
	default 4

config DIMM_SPD_SIZE
	default 512	# DDR4

config POST_DEVICE
	default n

config UART_FOR_CONSOLE
	default 0

config TPM_PIRQ
	hex
	default 0x61	# GPP_F11 TPM_PIRQ#

config FMDFILE
	default "src/mainboard/\$(CONFIG_MAINBOARD_DIR)/board.fmd"

config VBOOT
	default y
	select VBOOT_ALWAYS_ENABLE_DISPLAY
	select VBOOT_CLEAR_RECOVERY_IN_RAMSTAGE
	select VBOOT_NO_BOARD_SUPPORT
	select VBOOT_SLOTS_RW_AB

