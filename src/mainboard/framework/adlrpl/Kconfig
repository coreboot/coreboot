config BOARD_FRAMEWORK_ADLRPL_COMMON
	def_bool n
	select BOARD_ROMSIZE_KB_32768
	select DRIVERS_ACPI_THERMAL_ZONE
	select DRIVERS_I2C_HID
	select DRIVERS_INTEL_USB4_RETIMER
	select DRIVERS_INTEL_WIFI
	select EC_GOOGLE_CHROMEEC
	select EC_GOOGLE_CHROMEEC_ESPI
	select EC_GOOGLE_CHROMEEC_MEC
	select HAVE_ACPI_RESUME
	select HAVE_ACPI_TABLES
	select INTEL_GMA_HAVE_VBT
	select INTEL_LPSS_UART_FOR_CONSOLE
	select MEMORY_MAPPED_TPM
	select MAINBOARD_HAS_TPM2
	select NO_UART_ON_SUPERIO
	select SOC_INTEL_COMMON_BLOCK_HDA_VERB
	select SOC_INTEL_ENABLE_USB4_PCIE_RESOURCES
	select SPD_CACHE_ENABLE
	select SPD_CACHE_IN_FMAP
	select SPD_READ_BY_WORD
	select SYSTEM_TYPE_LAPTOP
	select TPM_MEASURED_BOOT

config BOARD_FRAMEWORK_HX30
	select BOARD_FRAMEWORK_ADLRPL_COMMON
	select SOC_INTEL_ALDERLAKE_PCH_P

if BOARD_FRAMEWORK_ADLRPL_COMMON

config MAINBOARD_DIR
	default "framework/adlrpl"

config MAINBOARD_PART_NUMBER
	default "hx30" if BOARD_FRAMEWORK_HX30

