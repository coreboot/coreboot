# SPDX-License-Identifier: GPL-2.0-or-later

chip soc/intel/alderlake
	# Vendor FADT sets "Low Power S0 Idle" and ships an LPIT
	register "s0ix_enable" = "true"

	# Enable Enhanced Intel SpeedStep
	register "eist_enable" = "true"

	# System Agent Geyserville (memory power management)
	register "sagv" = "SaGv_Enabled"

	# GPE0 routing. Only three groups can be mapped, and every pad that
	# declares a wake-capable GpioInt() needs its group here:
	#   GPP_B  touchpad     (GPP_B3  / SOC_TP_INT#)
	#   GPP_D  EC           (GPP_D3  / SOC_EC_INT#)
	#   GPP_F  touchscreen  (GPP_F13 / TS_INT#, touch SKUs only)
	# GPP_E holds no wake sources on this board.
	register "pmc_gpe0_dw0" = "GPP_B"
	register "pmc_gpe0_dw1" = "GPP_D"
	register "pmc_gpe0_dw2" = "GPP_F"

	device domain 0 on
		subsystemid 0xf111 0x0002 inherit

		device ref igpu on
			register "ddi_portA_config" = "1"
			register "ddi_ports_config[DDI_PORT_A]" = "DDI_ENABLE_HPD"

			register "panel_cfg" = "{
				.up_delay_ms = 200,
				.backlight_on_delay_ms = 1,
				.backlight_off_delay_ms = 200,
				.down_delay_ms = 50,
				.cycle_delay_ms = 500,
			}"
		end
		device ref dtt on end
		device ref tbt_pcie_rp0 on end
		device ref tbt_pcie_rp1 on end
		device ref tbt_pcie_rp2 on end
		device ref tbt_pcie_rp3 on end
		device ref gna on end
		device ref tcss_xhci on
			register "tcss_ports" = "{
				[0] = TCSS_PORT_DEFAULT(OC_SKIP),
				[1] = TCSS_PORT_DEFAULT(OC_SKIP),
				[2] = TCSS_PORT_DEFAULT(OC_SKIP),
				[3] = TCSS_PORT_DEFAULT(OC_SKIP)
			}"
			chip drivers/usb/acpi
				device ref tcss_root_hub on
					chip drivers/usb/acpi
						# right side, back
						register "desc" = ""USB3 Type-C JUSBC1""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(RIGHT, RIGHT, ACPI_PLD_GROUP(2, 1))"
						device ref tcss_usb3_port1 on end
					end
					chip drivers/usb/acpi
						# right side, front
						register "desc" = ""USB3 Type-C JUSBC2""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(RIGHT, LEFT, ACPI_PLD_GROUP(2, 0))"
						device ref tcss_usb3_port2 on end
					end
					chip drivers/usb/acpi
						# left side, front
						register "desc" = ""USB3 Type-C JUSBC3""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(LEFT, RIGHT, ACPI_PLD_GROUP(1, 0))"
						device ref tcss_usb3_port3 on end
					end
					chip drivers/usb/acpi
						# left side, back
						register "desc" = ""USB3 Type-C JUSBC4""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(LEFT, LEFT, ACPI_PLD_GROUP(1, 1))"
						device ref tcss_usb3_port4 on end
					end
				end
			end
		end
		# One Burnside Bridge retimer (JHL8040R) per Type-C port
		# SOC_DG_BB_FORCE_PWR (GPP_E4) force-powers all four.
		device ref tcss_dma0 on
			chip drivers/intel/usb4/retimer
				use tcss_usb3_port1 as dfp[0].typec_port
				use tcss_usb3_port2 as dfp[1].typec_port
				register "dfp[0].power_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_E4)"
				register "dfp[1].power_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_E4)"
				device generic 0 on end
			end
		end
		device ref tcss_dma1 on
			chip drivers/intel/usb4/retimer
				use tcss_usb3_port3 as dfp[0].typec_port
				use tcss_usb3_port4 as dfp[1].typec_port
				register "dfp[0].power_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_E4)"
				register "dfp[1].power_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_E4)"
				device generic 0 on end
			end
		end
		device ref xhci on
			register "usb2_ports" = "{
				/* [0] JDCI debug port */
				[1] = USB2_PORT_TYPE_C(OC_SKIP),	/* JTypeC USBC1 (right, back) */
				[2] = USB2_PORT_TYPE_C(OC_SKIP),	/* JTypeC USBC2 (right, front) */
				[3] = USB2_PORT_TYPE_C(OC_SKIP),	/* JTypeC USBC3 (left, front) */
				[4] = USB2_PORT_TYPE_C(OC_SKIP),	/* JTypeC USBC4 (left, back) */
				[6] = USB2_PORT_MID(OC_SKIP),		/* Camera */
				/* [7] Touch panel: unused, touchscreen is I2C */
				[8] = USB2_PORT_MID(OC_SKIP),		/* Fingerprint reader */
				[9] = USB2_PORT_MID(OC_SKIP),		/* Bluetooth */
			}"
			# Type-C SS is via TCSS. The only routed PCH USB3 port (3) is
			# the JDCI debug port, left disabled (see usb2_ports[0]).

			chip drivers/usb/acpi
				device ref xhci_root_hub on
					chip drivers/usb/acpi
						# right side, back
						device ref usb2_port2 on end
						register "desc" = ""USB2 Type-C JUSBC1""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(RIGHT, RIGHT, ACPI_PLD_GROUP(2, 1))"
					end
					chip drivers/usb/acpi
						# right side, front
						device ref usb2_port3 on end
						register "desc" = ""USB2 Type-C JUSBC2""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(RIGHT, LEFT, ACPI_PLD_GROUP(2, 0))"
					end
					chip drivers/usb/acpi
						# left side, front
						device ref usb2_port4 on end
						register "desc" = ""USB2 Type-C JUSBC3""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(LEFT, RIGHT, ACPI_PLD_GROUP(1, 0))"
					end
					chip drivers/usb/acpi
						# left side, back
						device ref usb2_port5 on end
						register "desc" = ""USB2 Type-C JUSBC4""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(LEFT, LEFT, ACPI_PLD_GROUP(1, 1))"
					end
					chip drivers/usb/acpi
						device ref usb2_port7 on end
						register "desc" = ""USB2 Camera""
						register "type" = "UPC_TYPE_INTERNAL"
					end
					# usb2_port8 (touch panel) is unused, the
					# touchscreen is on I2C (see i2c0)
					chip drivers/usb/acpi
						device ref usb2_port9 on end
						register "desc" = ""USB2 Fingerprint reader""
						register "type" = "UPC_TYPE_INTERNAL"
					end
					chip drivers/usb/acpi
						device ref usb2_port10 on end
						register "desc" = ""USB2 Bluetooth""
						register "type" = "UPC_TYPE_INTERNAL"
					end
				end
			end
		end
		device ref shared_sram on end
		device ref i2c0 on
			register "serial_io_i2c_mode[PchSerialIoIndexI2C0]" = "PchSerialIoPci"
			# System didn't come with a touchscreen, but Laptop 13 Pro touchscreen is compatible
			chip drivers/i2c/hid
				register "generic.hid" = ""CSW1322""
				register "generic.desc" = ""Touchscreen""
				register "generic.irq_gpio" = "ACPI_GPIO_IRQ_LEVEL_LOW_WAKE(GPP_F13)"
				register "generic.detect" = "1"
				register "hid_desc_reg_offset" = "0x01"
				device i2c 41 on end
			end
		end
		device ref i2c1 on
			register "serial_io_i2c_mode[PchSerialIoIndexI2C1]" = "PchSerialIoPci"
			# EC I2C HID: media keys, Airplane Button and ALS sensor
			chip drivers/i2c/hid
				register "generic.hid" = ""FRMW0001""
				register "generic.desc" = ""EC HID""
				register "generic.irq_gpio" = "ACPI_GPIO_IRQ_LEVEL_LOW(GPP_D3)"
				register "hid_desc_reg_offset" = "0x55"
				device i2c 50 on end
			end
		end
		device ref i2c3 on
			register "serial_io_i2c_mode[PchSerialIoIndexI2C3]" = "PchSerialIoPci"
			chip drivers/i2c/hid
				register "generic.hid" = ""PIXA3854""
				register "generic.desc" = ""Touchpad""
				register "generic.irq_gpio" = "ACPI_GPIO_IRQ_LEVEL_LOW_WAKE(GPP_B3)"
				register "hid_desc_reg_offset" = "0x20"
				device i2c 2c on end
			end
		end
		# M.2/M 2280 SSD hangs off the CPU-attached x4 port (PEG60, 00:06.0)
		device ref pcie4_0 on
			register "cpu_pcie_rp[CPU_RP(1)]" = "{
				.clk_src = 3,
				.clk_req = 3,
				.flags = PCIE_RP_LTR | PCIE_RP_AER,
				.pcie_rp_aspm = ASPM_DISABLE,
				.PcieRpL1Substates = L1_SS_DISABLED,
			}"
			chip soc/intel/common/block/pcie/rtd3
				register "reset_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_F20)"
				register "srcclk_pin" = "3"
				device generic 0 on end
			end
			smbios_slot_desc "SlotTypeM2Socket3" "SlotLengthOther" "M.2/M 2280 (JSSD)" "SlotDataBusWidth4X"
		end
		# WiFi: discrete PCIe module in M.2/E 2230 (JWLAN) slot
		device ref pcie_rp9 on
			register "pch_pcie_rp[PCH_RP(9)]" = "{
				.clk_src = 4,
				.clk_req = 4,
			}"
			chip drivers/wifi/generic
				register "wake" = "GPE0_PME_B0"
				device generic 0 on end
			end
			smbios_slot_desc "SlotTypeM2Socket1_SD" "SlotLengthOther" "M.2/E 2230 (JWLAN)" "SlotDataBusWidth1X"
		end
		device ref uart0 on
			register "serial_io_uart_mode[PchSerialIoIndexUART0]" = "PchSerialIoSkipInit"
		end
		device ref pch_espi on
			register "gen1_dec" = "LPC_IO(0x200, 0x10)"	# EC host cmd:  0x200-0x20F
			register "gen2_dec" = "LPC_IO(0x800, 0x10)"	# EC EMI window: 0x800-0x80F
			chip drivers/pc80/tpm
				device pnp 0c31.0 on end
			end
			chip ec/google/chromeec
				device pnp 0c09.0 alias chrome_ec on end
			end
		end
		device ref hda on
			register "pch_hda_audio_link_hda_enable" = "1"
			register "pch_hda_sdi_enable[0]" = "true"
			register "pch_hda_idisp_codec_enable" = "1"
			register "pch_hda_idisp_link_frequency" = "HDA_LINKFREQ_96MHZ"
			register "pch_hda_idisp_link_tmode" = "HDA_TMODE_8T"
		end
		device ref smbus on end
		device ref fast_spi on end
	end
end
