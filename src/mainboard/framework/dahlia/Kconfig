	default 1024

config ONBOARD_VGA_IS_PRIMARY
	default y

config POST_DEVICE
	default n

config UART_FOR_CONSOLE
	default 0

# PM Timer disabled, saves power
config USE_PM_ACPI_TIMER
	default n

endif
