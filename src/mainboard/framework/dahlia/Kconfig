if BOARD_FRAMEWORK_DAHLIA_COMMON

config MAINBOARD_DIR
	default "framework/dahlia"

config FMDFILE
	default "src/mainboard/\$(CONFIG_MAINBOARD_DIR)/board.fmd"

config VBOOT
	default y
	select VBOOT_ALWAYS_ENABLE_DISPLAY
	select VBOOT_CLEAR_RECOVERY_IN_RAMSTAGE
	select VBOOT_NO_BOARD_SUPPORT
	select VBOOT_SLOTS_RW_AB

# The PTL/WCL SoC default RAMSTAGE_CBFS_CACHE_SIZE is sized only for FSP-S
# preloading. The UEFI payload is much larger, so enlarge the cache to fit
# dsdt.aml + the payload (see sakura for the same workaround).
config RAMSTAGE_CBFS_CACHE_SIZE
	default 0x200000

config MAINBOARD_PART_NUMBER
	default "Dahlia"

