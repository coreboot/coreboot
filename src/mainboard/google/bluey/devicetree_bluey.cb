# CDT fw_config layout for BLUEY:
#   [15:0]  : Platform ID
#   [31:16] : SoC ID
#   [34:32] : Storage Type (normalized from BOOT_CONFIG FAST_BOOT field)
fw_config
	field PLATFORM_ID 0 15 end
	field SOC_ID 16 31
		option HAMOA		0x022b
		option X1P42100		0x027b
		option CANIM		0x031f
	end
	field STORAGE_TYPE 32 34
		option STORAGE_TYPE_UNKNOWN	0
		option STORAGE_TYPE_NVME	1
		option STORAGE_TYPE_UFS		2
	end
end

chip soc/qualcomm/x1p42100
	device cpu_cluster 0 on end
	device domain 0 on
		device pci 00.0 on end # Root Bridge
	end
end
