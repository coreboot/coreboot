config BOARD_GOOGLE_DOUGIE_COMMON
	def_bool n
	select BOARD_ROMSIZE_KB_32768
	select COMMON_CBFS_SPI_WRAPPER
	select MAINBOARD_HAS_CHROMEOS
	select SOC_QUALCOMM_DOUGIE
	select SPI_FLASH
	select SPI_FLASH_FORCE_4_BYTE_ADDR_MODE
	select SPI_FLASH_INCLUDE_ALL_DRIVERS

config BOARD_GOOGLE_DOUGIE
	select BOARD_GOOGLE_DOUGIE_COMMON
	select MAINBOARD_HAS_AMP_VIA_I2C
	select MAINBOARD_HAS_KEYBOARD_VIA_I2C

config BOARD_GOOGLE_BANDIT
	select BOARD_GOOGLE_DOUGIE_COMMON
	select MAINBOARD_HAS_CHROME_EC
	select MAINBOARD_HAS_GOOGLE_TPM

if BOARD_GOOGLE_DOUGIE_COMMON

config MAINBOARD_HAS_AMP_VIA_I2C
	bool
	default n
	help
	  Enable this option if your mainboard has an audio amplifier on I2C.

config MAINBOARD_HAS_CHROME_EC
	bool
	default n
	select EC_GOOGLE_CHROMEEC
	select EC_GOOGLE_CHROMEEC_RTC
	select EC_GOOGLE_CHROMEEC_SPI
	select RTC
	help
	  Enable this option if your mainboard is equipped with Chrome EC.

config MAINBOARD_HAS_GOOGLE_TPM
	bool
	default n
	select I2C_TPM
	select MAINBOARD_HAS_TPM2
	select TPM_GOOGLE_TI50
	help
	  Enable this option if your mainboard is equipped with Google TPM.

config MAINBOARD_HAS_KEYBOARD_VIA_I2C
	bool
	default n
	help
	  Enable this option if your mainboard has a keyboard controller on I2C.

config VBOOT
	select EC_GOOGLE_CHROMEEC_SWITCHES if MAINBOARD_HAS_CHROME_EC
	select VBOOT_LID_SWITCH if MAINBOARD_HAS_CHROME_EC
	select VBOOT_MOCK_SECDATA if !MAINBOARD_HAS_GOOGLE_TPM
	select VBOOT_NO_BOARD_SUPPORT if !MAINBOARD_HAS_CHROME_EC
	select VBOOT_VBNV_FLASH

config MAINBOARD_DIR
	default "google/dougie"

##########################################################
#### Update below when adding a new derivative board. ####
##########################################################

config MAINBOARD_PART_NUMBER
	default "Dougie" if BOARD_GOOGLE_DOUGIE
	default "Bandit" if BOARD_GOOGLE_BANDIT

config FMDFILE
	default "src/mainboard/\$(CONFIG_MAINBOARD_DIR)/chromeos.fmd" if MAINBOARD_HAS_GOOGLE_TPM
	default "src/mainboard/\$(CONFIG_MAINBOARD_DIR)/chromeos-nogsc.fmd"

config DRIVER_TPM_I2C_BUS
	depends on I2C_TPM
	hex
	default 0xE

config DRIVER_TPM_I2C_ADDR
	depends on I2C_TPM
	hex
	default 0x50

config EC_GOOGLE_CHROMEEC_SPI_BUS
	depends on EC_GOOGLE_CHROMEEC
	hex
	default 0xA

config MAINBOARD_HAS_UFS
	bool "Enable UFS storage"
	default y
	help
	  Enable this option if your mainboard is equipped with UFS
	  storage.

config MAINBOARD_HAS_EMMC
	bool "Enable eMMC (SDC1) storage"
	default n
	help
	  Enable this option if your mainboard is equipped with eMMC
	  storage on SDC1 and you want coreboot to initialize SDCC1
	  clocks, TLMM pads, and early CMD1 during ramstage.

config MAINBOARD_HAS_NVME
	bool "Enable NVMe (PCIe1) storage"
	default y if BOARD_GOOGLE_DOUGIE
	default n
	help
	  Enable this option if your mainboard is equipped with NVMe
	  storage on PCIe1 and you want coreboot to initialize the PCIe
	  root complex during ramstage.

endif # BOARD_GOOGLE_DOUGIE_COMMON
