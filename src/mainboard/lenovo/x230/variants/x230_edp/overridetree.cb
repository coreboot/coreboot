chip northbridge/intel/sandybridge
	device domain 0 on
		chip southbridge/intel/bd82x6x # Intel Series 7 Panther Point PCH
			device ref lpc on
				chip ec/lenovo/h8
					# Avoid H8_CONFIG1 bit 2: it leaves ThinkLight stuck on.
					register "config1_reserved_mask" = "1 << 2"
					register "has_thinklight" = "true"
					register "has_keyboard_backlight" = "true"
				end
			end
		end
	end
end
