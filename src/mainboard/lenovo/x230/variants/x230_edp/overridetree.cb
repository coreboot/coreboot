chip northbridge/intel/sandybridge
	register "gpu_panel_port_select" = "PANEL_PORT_DP_D"
	register "gpu_panel_power_cycle_delay" = "5"		# T12, unit 100ms
	# remaining delays use unit 100us:
	register "gpu_panel_power_up_delay" = "2000"		# T3
	register "gpu_panel_power_down_delay" = "100"		# T10
	# Intel PRM suggests to set backlight on delay to 1 for DP
	register "gpu_panel_power_backlight_on_delay" = "1"	# T8?
	register "gpu_panel_power_backlight_off_delay" = "1"	# T9

	device domain 0 on
		# workaround to preserve subsystemid
		# can be removed once CB:95722 is merged
		subsystemid 0x17aa 0x21fa inherit
	end
end
