			BOOTBLOCK(CBFS) 4224K
			COREBOOT(CBFS)
		}
		RECOVERY_B 7616K {
			BOOTBLOCK_B(CBFS) 4224K
			COREBOOT_B(CBFS)
		}
		PSP_NVRAM(PRESERVE) 128K
		PSP_RPMC_NVRAM(PRESERVE) 256K
		SMMSTORE(PRESERVE) 256K
