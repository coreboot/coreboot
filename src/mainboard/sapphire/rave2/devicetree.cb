# SPDX-License-Identifier: GPL-2.0-only

chip soc/amd/glinda
	# eSPI: Quad I/O mode at 33 MHz
	register "common_config.espi_config" = "{
		.std_io_decode_bitmap = ESPI_DECODE_IO_0x80_EN | ESPI_DECODE_IO_0X60_0X64_EN,
		.generic_io_range[0] = {
			.base = 0x3f8,
			.size = 8,
		},
		.io_mode = ESPI_IO_MODE_QUAD,
		.op_freq_mhz = ESPI_OP_FREQ_33_MHZ,
		.crc_check_enable = 1,
		.alert_pin = ESPI_ALERT_PIN_PUSH_PULL,
		.periph_ch_en = 1,
		.vw_ch_en = 1,
		.oob_ch_en = 1,
		.flash_ch_en = 0,
	}"

	# TODO: verify slow/fast PPT limits against Rave2 TDP spec
	register "slow_ppt_limit_mW" = "65000"
	register "fast_ppt_limit_mW" = "65000"

	register "i2c_scl_reset" = "GPIO_I2C0_SCL | GPIO_I2C1_SCL |
					GPIO_I2C2_SCL | GPIO_I2C3_SCL"

	# I2C voltage levels: 1.8V for all buses
	register "i2c_pad[0].rx_level" = "I2C_PAD_RX_1_8V"
	register "i2c_pad[1].rx_level" = "I2C_PAD_RX_1_8V"
	register "i2c_pad[2].rx_level" = "I2C_PAD_RX_1_8V"
	register "i2c_pad[3].rx_level" = "I2C_PAD_RX_1_8V"

	register "s0ix_enable" = "true"

	# TODO: verify PSPP policy in hardware
	register "pspp_policy" = "DXIO_PSPP_DISABLED"

	register "gpp_clk_config[0]" = "GPP_CLK_REQ" # M.2 M-key NVMe (M2M_CLK, CLK_REQ0)
	register "gpp_clk_config[1]" = "GPP_CLK_OFF" # NC
	register "gpp_clk_config[2]" = "GPP_CLK_REQ" # 10GbE AQC113 (LAN_CLK, CLK_REQ2)
	register "gpp_clk_config[3]" = "GPP_CLK_REQ" # M.2 E-key WiFi/BT (M2E_CLK, CLK_REQ3)
	register "gpp_clk_config[4]" = "GPP_CLK_ON"  # VE3558 PCIe x2 (VE3558_CLK, no CLKREQ# pin)
	register "gpp_clk_config[5]" = "GPP_CLK_ON"  # OcuLink PCIe 4.0 x4 J6 (GFX_CLK, no CLKREQ# pin)
	register "gpp_clk_config[6]" = "GPP_CLK_OFF" # NC

	device domain 0 on
		device ref iommu on end

		# M.2 M-key PCIe 4.0 x4 NVMe SSD (M2)
		device ref gpp_bridge_2_1 on
			# Required so the NVMe gets placed into D3 when entering S0i3.
			chip drivers/pcie/rtd3/device
				register "name" = ""NVME""
				device pci 00.0 on end
			end
		end

		# 10GbE AQC113 (lower RJ45)
		device ref gpp_bridge_3_1 on
			device pci 0.0 on end
		end

		# M.2 E-key PCIe 4.0 x1 WiFi/BT (M1)
		device ref gpp_bridge_3_2 on end

		# VE3558 PCIe x2
		device ref gpp_bridge_3_3 on end

		# OcuLink PCIe 4.0 x4 (J6)
		device ref gpp_bridge_3_4 on end

		device ref gpp_bridge_a on  # Internal GPP Bridge 0 to Bus A
			device ref gfx on end # Internal GPU (GFX)
			device ref gfx_hda on end # Display HD Audio Controller (GFXAZ)
			device ref crypto on end # Crypto Coprocessor
			# USB 3.1 (USB1) - USB32 onboard header
			device ref xhci_1 on
				chip drivers/usb/acpi
					device ref xhci_1_root_hub on
						chip drivers/usb/acpi
							register "desc" = ""USB-3.2-A-HDR1""
							register "type" = "UPC_TYPE_USB3_A"
							register "group" = "ACPI_PLD_GROUP(7, 0)"
							device ref usb3_port7 on end
						end
						chip drivers/usb/acpi
							register "desc" = ""USB-3.2-A-HDR1""
							register "type" = "UPC_TYPE_USB3_A"
							register "group" = "ACPI_PLD_GROUP(7, 0)"
							device ref usb2_port7 on end
						end
					end
				end
			end
		end

		device ref gpp_bridge_c on  # Internal GPP Bridge 2 to Bus C
			# USB 3.1 (USB0) - USB7216C hub on ports 3 (upstream), 3x Type A (downstream)
			device ref xhci_0 on
				chip drivers/usb/acpi
					device ref xhci_0_root_hub on
						# USB7216C USB 3.2 hub on port 3
						chip drivers/usb/acpi
							device ref usb3_port3 on
								chip drivers/usb/hub
									register "desc" = ""USB7216C Hub""
									register "name" = ""USB7216C""
									register "port_count" = "6"
									device usb 0.0 on
										chip drivers/usb/acpi
											register "desc" = ""USB-3.2-A-Rear0""
											register "type" = "UPC_TYPE_USB3_A"
											register "group" = "ACPI_PLD_GROUP(3, 0)"
											device usb 3.2 on end
										end
										chip drivers/usb/acpi
											register "desc" = ""USB-3.2-A-Rear1""
											register "type" = "UPC_TYPE_USB3_A"
											register "group" = "ACPI_PLD_GROUP(2, 0)"
											device usb 3.3 on end
										end
										chip drivers/usb/acpi
											register "desc" = ""USB-3.2-A-Rear2""
											register "type" = "UPC_TYPE_USB3_A"
											register "group" = "ACPI_PLD_GROUP(4, 0)"
											device usb 3.4 on end
										end
									end
								end
							end
						end
						# USB7216C USB 2.0 hub on port 3
						chip drivers/usb/acpi
							device ref usb2_port3 on
								chip drivers/usb/hub
									register "desc" = ""USB7216C Hub""
									register "name" = ""USB7216C""
									register "port_count" = "6"
									device usb 0.0 on
										chip drivers/usb/acpi
											register "desc" = ""USB-2.0-A-Rear0""
											register "type" = "UPC_TYPE_A"
											register "group" = "ACPI_PLD_GROUP(3, 0)"
											device usb 2.2 on end
										end
										chip drivers/usb/acpi
											register "desc" = ""USB-2.0-A-Rear1""
											register "type" = "UPC_TYPE_A"
											register "group" = "ACPI_PLD_GROUP(2, 0)"
											device usb 2.3 on end
										end
										chip drivers/usb/acpi
											register "desc" = ""USB-2.0-A-Rear2""
											register "type" = "UPC_TYPE_A"
											register "group" = "ACPI_PLD_GROUP(4, 0)"
											device usb 2.4 on end
										end
									end
								end
							end
						end
					end
				end
			end

			# USB-C rear port (USB3.2 Gen 2 Type C with DP capability - DDI3)
			device ref usb4_xhci_1 on
				chip drivers/usb/acpi
					register "type" = "UPC_TYPE_HUB"
					device ref usb4_xhci_1_root_hub on
						chip drivers/usb/acpi
							register "desc" = ""USB-C-Rear""
							register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
							register "group" = "ACPI_PLD_GROUP(0, 0)"
							device ref usb3_port1 on end
						end
						chip drivers/usb/acpi
							register "desc" = ""USB-C-Rear""
							register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
							register "group" = "ACPI_PLD_GROUP(0, 0)"
							device ref usb2_port1 on end
						end
					end
				end
			end
		end
	end

	device ref uart_0 on end # UART0 - debug header J7

	chip drivers/amd/ftpm
		device mmio 0xfd2108d0 on end
	end
end
