config SOC_AMPERE_ALTRA
	bool
	default n
	select ARCH_BOOTBLOCK_ARMV8_64
	select ARCH_VERSTAGE_ARMV8_64
	select ARCH_ROMSTAGE_ARMV8_64
	select ARCH_RAMSTAGE_ARMV8_64
	select ARM64_USE_ARCH_TIMER
	select BOOTBLOCK_CUSTOM
	select FLATTENED_DEVICE_TREE
	select DRIVERS_UART_PL011
	help
	  Ampere Altra (AC01) and Altra Max (AC02) server processors with Arm
	  Neoverse N1 cores.

# TF-A has already initialized the DRAM, so there is no romstage
config SEPARATE_ROMSTAGE
	default n if SOC_AMPERE_ALTRA

if SOC_AMPERE_ALTRA

config ARM64_CURRENT_EL
	int
	default 2

config MEMLAYOUT_LD_FILE
	string
	default "src/soc/ampere/altra/memlayout.ld"

# Ampere Altra Max has up to 128 cores
config MAX_CPUS
	int
	default 128

# Size of the DRAM at _dram (0x80000000), which is always fully populated.
# CBMEM is placed at its top; the actual DRAM layout comes from the TF-A HOB.
config DRAM_SIZE_MB
	int
	default 2048

config AMPERE_ALTRA_TFA_FILE
	string "Path to the TF-A image"
	default ""
	help
	  The TF-A image of Ampere, which is written to the TFA_BIN region of
	  the flash.

config AMPERE_ALTRA_BL33_KEY
	string "Path to the BL33 signing key"
	default ""
	help
	  The RSA private key the content certificate of the non-trusted
	  firmware (BL33, the coreboot bootblock) is signed with. TF-A only
	  runs BL33 if the certificate is signed with a key it trusts.

config AMPERE_ALTRA_BOARD_SETTINGS_FILE
	string "Path to the board settings"
	default ""
	help
	  The board settings (NVPARAM) that TF-A and the SMpro read from the
	  BOARD_SETTINGS region of the flash. Either a text file in the format
	  of the Ampere reference board settings, which is converted with
	  util/ampere/nvparam.py, or an already converted .bin file.

endif # SOC_AMPERE_ALTRA
