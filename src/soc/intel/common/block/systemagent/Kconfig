config SOC_INTEL_COMMON_BLOCK_SA
	bool
	select SOC_INTEL_COMMON_BASECODE
	help
	  Intel Processor common System Agent support

if SOC_INTEL_COMMON_BLOCK_SA

config DOMAIN_RESOURCE_32BIT_LIMIT
	default 0xe0000000

config ECAM_MMCONF_BASE_ADDRESS
	default 0xe0000000

config ECAM_MMCONF_BUS_NUMBER
	default 256

config SA_ENABLE_IMR
	bool
	default n
	help
	  This option allows you to add the isolated memory ranges (IMRs).

config SA_ENABLE_DPR
	bool
	default n
	help
	  This option allows you to add the DMA Protected Range (DPR).

config SA_RESERVE_LOW_IOVA_FOR_EXTERNAL_DMA
	bool
	default n
	help
	  Reserve address space between TOUUD and
	  SA_RESERVE_LOW_IOVA_FOR_EXTERNAL_DMA_LIMIT as unusable for PCI MMIO
	  BAR placement, so the coreboot resource allocator places 64-bit
	  MMIO BARs starting at that limit instead of directly above TOUUD.
	  This frees up the address range below the limit for use as
	  contiguous IOVA space by devices with large IOMMU-mapped DMA
	  address requirements (e.g. an NPU), matching the placement behavior
	  of the EDK2 UEFI BIOS on the same platform.

config SA_RESERVE_LOW_IOVA_FOR_EXTERNAL_DMA_LIMIT
	hex
	default 0x10000000000
	depends on SA_RESERVE_LOW_IOVA_FOR_EXTERNAL_DMA
	help
	  Upper bound (exclusive) of the [TOUUD, limit) range reserved by
	  SA_RESERVE_LOW_IOVA_FOR_EXTERNAL_DMA. Defaults to 1TiB
	  (0x10000000000).

config ACPI_BERT_SIZE
	hex
	default 0x10000 if ACPI_BERT
	default 0x0
	help
	  Specify the amount of DRAM reserved for gathering the data used to
	  generate the ACPI table.

config HAVE_PAM0_REGISTER
	bool
	default y
	help
	  Specify if the SOC has a PAM0 register

config HAVE_CAPID_A_REGISTER
	bool
	default y
	help
	  Specify if the SOC has the CAPID0_A register that holds DRAM infomations.

config HAVE_BDSM_BGSM_REGISTER
	bool
	default y
	help
	  Specify if the SOC has BDSM and BGSM registers.

endif
